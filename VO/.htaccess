# Block direct web access to secrets
<IfModule mod_authz_core.c>
  <Files ".env">
    Require all denied
  </Files>
</IfModule>
<IfModule !mod_authz_core.c>
  <Files ".env">
    Order allow,deny
    Deny from all
  </Files>
</IfModule>
Options -Indexes
DirectoryIndex index.php

<FilesMatch "^(studio\.html|auth\.php|corrections_db\.php|schema_corrections\.sql|schema_settings\.sql)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
